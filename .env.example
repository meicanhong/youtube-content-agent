# Editorial provider: openai (default) or mimo.
EDITORIAL_PROVIDER=openai

# Default production provider: GPT-5.6 Luna through an OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=http://47.84.236.4:8080/v1

# Optional alternative provider: Xiaomi MiMo V2.5.
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Recommended for fast/reliable youtube-content-trend runs; manual URL generation does not need it.
# Without it, use the slower yt-dlp + browser-session fallback documented in README.
YOUTUBE_API_KEY=

# Optional explicit paths.
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional browser cookie import for videos YouTube refuses anonymously.
# Example: chrome, safari, firefox. Never commit exported cookies.
YT_DLP_COOKIES_FROM_BROWSER=
